{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueRoblox Admin",
  "version": "1.0.0",
  "identifier": "shop.blueroblox.pc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BlueRoblox",
    "shortDescription": "BlueRoblox Admin - quản lý điện thoại đám mây",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
